# Copy to cli/.env and fill in. Real environment variables override these values.

# Your Send to Kindle address (Amazon: Manage Your Content and Devices > Preferences >
# Personal Document Settings).
S2K_KINDLE_EMAIL=your-name@kindle.com

# Must be on the "Approved Personal Document E-mail List" in the same Amazon page.
S2K_SENDER_EMAIL=you@gmail.com

# Gmail: an app password (https://myaccount.google.com/apppasswords), not your account password.
S2K_SMTP_PASSWORD=

# Optional. Defaults shown work for Gmail.
# S2K_SMTP_HOST=smtp.gmail.com
# S2K_SMTP_PORT=587
# S2K_SMTP_SECURITY=starttls   # starttls (usually port 587) or ssl (usually port 465)
# S2K_SMTP_USERNAME=           # empty: uses S2K_SENDER_EMAIL
